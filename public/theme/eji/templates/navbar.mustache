{{!
    @template theme_eji/navbar

    EJI ONE topbar.

    Boost puts the primary navigation in here as a horizontal menu; EJI moves
    that into the sidebar, so the topbar is left with the page title and the
    user-facing actions. Nothing is dropped: search, the language menu, the
    edit switch, message and notification popovers, and the user menu are all
    still rendered by the same core output methods Boost uses. Only their
    arrangement changes.

    Context variables required for this template:
    * output - Core renderer.
    * topbartitle - Heading for the current page.
    * langmenu, usermenu - From core\navigation\output\primary.

    Example context (json):
    {
        "output": {
            "search_box": "",
            "navbar_plugin_output": "",
            "edit_switch": "",
            "page_heading_menu": ""
        },
        "topbartitle": "My courses",
        "sitename": "EJI LMS",
        "langmenu": false,
        "usermenu": ""
    }
}}
<header class="navbar navbar-expand eji-topbar" aria-label="{{#str}}sitemenubar, admin{{/str}}">
    <div class="eji-topbar__inner">
        {{! Sidebar toggle. Unlike Boost's, this is shown at every width: above
            992px it collapses the persistent column, below it opens the overlay. }}
        <button
            class="btn btn-icon eji-topbar__toggle"
            data-toggler="drawers"
            data-action="toggle"
            data-target="theme_boost-drawers-primary"
            data-bs-toggle="tooltip"
            data-bs-placement="bottom"
            title="{{#str}}togglesidebar, theme_eji{{/str}}"
        >
            <span class="visually-hidden">{{#str}}togglesidebar, theme_eji{{/str}}</span>
            {{#pix}} i/menubars, core {{/pix}}
        </button>

        <h1 class="eji-topbar__title" title="{{topbartitle}}">{{topbartitle}}</h1>

        <span class="eji-topbar__spacer"></span>

        <div id="usernavigation" class="navbar-nav eji-topbar__actions">
            {{# output.search_box }}
                <div class="eji-topbar__search">{{{ output.search_box }}}</div>
            {{/output.search_box}}
            {{# output.page_heading_menu}}
                <ul class="navbar-nav d-none d-md-flex my-1 px-1">
                    {{{ output.page_heading_menu }}}
                </ul>
            {{/output.page_heading_menu}}
            {{{ output.edit_switch }}}
            {{#langmenu}}
                {{> theme_boost/language_menu }}
            {{/langmenu}}
            {{! Messages, notifications and any other navbar plugin output.
                Rendered by core - the theme only restyles the popovers. }}
            {{# output.navbar_plugin_output }}
                {{{ . }}}
            {{/output.navbar_plugin_output}}
            {{#usermenu}}
                <div class="d-flex align-items-stretch usermenu-container" data-region="usermenu">
                    {{> core/user_menu }}
                </div>
            {{/usermenu}}
        </div>
    </div>
</header>
