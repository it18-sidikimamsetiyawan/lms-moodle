{{!
    @template theme_eji/login

    EJI ONE login page shell.

    Boost's split-screen structure is kept as-is - it is already the shape the
    brief asks for. Only the left panel's content and the styling change. The
    login form comes from core/loginform via output.main_content, so username,
    password, login token, identity providers, guest access and the
    forgotten-password flow all behave exactly as core defines them.

    Context variables required for this template:
    * output - Core renderer.
    * bodyattributes - Body attributes string.
    * ejibrand, ejitagline - Branding for the left panel.

    Example context (json):
    {
        "output": {
            "doctype": "<!DOCTYPE html>",
            "page_title": "Log in",
            "favicon": "favicon.ico",
            "main_content": "<form>Login form</form>"
        },
        "bodyattributes": "",
        "ejibrand": "EJI",
        "ejitagline": "EJI Learning Portal"
    }
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

<div id="page-wrapper">

    {{{ output.standard_top_of_body_html }}}

    <div id="page" class="mt-0">
        {{> core/login_layout }}
    </div>
</div>

</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
  M.util.js_complete('theme_boost/loader');
});
{{/js}}
