{{!
    @template local_hrdashboard/progress

    Progress rail with the percentage beside it; a dash when the course does
    not track completion. Turns green at 100%.

    Context variables required for this template:
    * hasprogress - bool
    * progress - int 0..100
    * done - bool (100%)

    Example context (json):
    { "hasprogress": true, "progress": 75, "done": false }
}}
{{#hasprogress}}
<div class="hrd-progress{{#done}} hrd-progress--done{{/done}}">
    <div class="progress" role="progressbar" aria-valuenow="{{progress}}" aria-valuemin="0" aria-valuemax="100" aria-label="{{#str}}courseprogress, local_hrdashboard{{/str}}">
        <div class="progress-bar" style="width: {{progress}}%"></div>
    </div>
    <span class="hrd-progress__value">{{progress}}%</span>
</div>
{{/hasprogress}}
{{^hasprogress}}<span class="hrd-muted">—</span>{{/hasprogress}}
