{{!
    @template local_hrdashboard/user_detail

    One learner: profile strip, course list, then the activities of the selected course.

    Context variables required for this template:
    * user - {fullname, initials, attrs: [{label, value}], lastlogin}
    * summary - [{label, value}]
    * backurl, backlabel, isself
    * courses - [{url, fullname, shortname, progress, progresspct, status, score, lastactivity, pending, active, reasons, hasreasons}]; hascourses
    * selected - {fullname, viewurl, enabled, progress, done, tracked, activities: [...], hasactivities} or false

    Example context (json):
    {
        "user": {"fullname": "Dewi Lestari", "initials": "DL", "attrs": [], "lastlogin": "Today"},
        "summary": [], "backurl": "#", "backlabel": "Back", "isself": false,
        "courses": [], "hascourses": false, "selected": false
    }
}}
<div class="hrd">
    <div class="hrd-pagehead">
        <a class="hrd-back" href="{{{backurl}}}">&larr; {{backlabel}}</a>
    </div>

    <section class="hrd-surface">
        <div class="hrd-profile">
            <span class="hrd-avatar hrd-avatar--lg" aria-hidden="true">{{user.initials}}</span>
            <div>
                <h2 class="hrd-profile__name">{{user.fullname}}</h2>
                <dl class="hrd-profile__attrs">
                    {{#user.attrs}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/user.attrs}}
                    <div><dt>{{#str}}col:lastlogin, local_hrdashboard{{/str}}</dt><dd>{{user.lastlogin}}</dd></div>
                </dl>
            </div>
            <div class="hrd-profile__kpis">
                {{#summary}}
                <div class="hrd-stat" style="border:0;padding:0">
                    <span class="hrd-stat__label">{{label}}</span>
                    <span class="hrd-stat__value">{{value}}</span>
                </div>
                {{/summary}}
            </div>
        </div>
    </section>

    <section class="hrd-surface" aria-labelledby="hrd-uc-title">
        <div class="hrd-surface__head hrd-surface__head--divided">
            <div>
                <h3 class="hrd-surface__title" id="hrd-uc-title">{{#str}}section:courses, local_hrdashboard{{/str}}</h3>
            </div>
        </div>
        <div class="hrd-surface__body hrd-surface__body--flush">
            {{#hascourses}}
            <div class="hrd-table-wrap">
            <table class="hrd-table" data-hrd-sortable>
                <thead><tr>
                    <th scope="col"><button type="button" class="hrd-sort">{{#str}}col:course, local_hrdashboard{{/str}}</button></th>
                    <th scope="col" style="min-width:160px"><button type="button" class="hrd-sort">{{#str}}col:progress, local_hrdashboard{{/str}}</button></th>
                    <th scope="col" class="num"><button type="button" class="hrd-sort">{{#str}}col:pending, local_hrdashboard{{/str}}</button></th>
                    <th scope="col" class="num">{{#str}}col:score, local_hrdashboard{{/str}}</th>
                    <th scope="col"><button type="button" class="hrd-sort">{{#str}}col:lastactivity, local_hrdashboard{{/str}}</button></th>
                    <th scope="col">{{#str}}col:status, local_hrdashboard{{/str}}</th>
                    <th scope="col"></th>
                </tr></thead>
                <tbody>
                {{#courses}}
                <tr{{#active}} class="table-active"{{/active}}>
                    <td data-sort="{{fullname}}"><a class="name" href="{{{url}}}">{{fullname}}</a><span class="sub">{{shortname}}</span></td>
                    <td data-sort="{{progresspct}}">{{#progress}}{{> local_hrdashboard/progress }}{{/progress}}</td>
                    <td class="num" data-sort="{{pending}}">{{pending}}</td>
                    <td class="num">{{score}}</td>
                    <td data-sort="{{lastsort}}">{{lastactivity}}</td>
                    <td>{{#status}}{{> local_hrdashboard/status }}{{/status}}{{#hasreasons}}<ul class="hrd-reasons mt-1">{{#reasons}}<li>{{.}}</li>{{/reasons}}</ul>{{/hasreasons}}</td>
                    <td class="num cell-min"><a class="btn btn-sm {{#active}}btn-primary{{/active}}{{^active}}btn-outline-secondary{{/active}}" href="{{{url}}}">{{#str}}section:activities, local_hrdashboard{{/str}}</a></td>
                </tr>
                {{/courses}}
                </tbody>
            </table>
            </div>
            {{/hascourses}}
            {{^hascourses}}
            <div class="hrd-empty">
                <p class="hrd-empty__title">{{#str}}empty:nocoursestitle, local_hrdashboard{{/str}}</p>
                <p class="hrd-empty__text">{{#str}}empty:nocoursestext, local_hrdashboard{{/str}}</p>
            </div>
            {{/hascourses}}
        </div>
    </section>

    {{#selected}}
    <section class="hrd-surface" aria-labelledby="hrd-sel-title">
        <div class="hrd-surface__head hrd-surface__head--divided">
            <div>
                <h3 class="hrd-surface__title" id="hrd-sel-title">{{fullname}}</h3>
                {{#enabled}}<p class="hrd-surface__desc">{{#str}}activitiescompletedlong, local_hrdashboard, { "done": "{{done}}", "total": "{{tracked}}" }{{/str}}</p>{{/enabled}}
            </div>
            <div class="hrd-pagehead__actions">
                {{#enabled}}<div class="hrd-progress hrd-progress--lg" style="min-width:200px">{{#progress}}{{> local_hrdashboard/progress }}{{/progress}}</div>{{/enabled}}
                <a class="btn btn-outline-secondary btn-sm" href="{{{viewurl}}}">{{#str}}viewcourse, local_hrdashboard{{/str}}</a>
            </div>
        </div>
        <div class="hrd-surface__body hrd-surface__body--flush">
            {{^enabled}}
            <div class="hrd-empty"><p class="hrd-empty__title">{{#str}}completionnotenabled, local_hrdashboard{{/str}}</p></div>
            {{/enabled}}
            {{#enabled}}
            {{#hasactivities}}
            <div class="hrd-table-wrap">
            <table class="hrd-table">
                <thead><tr>
                    <th scope="col">{{#str}}col:activity, local_hrdashboard{{/str}}</th>
                    <th scope="col">{{#str}}col:section, local_hrdashboard{{/str}}</th>
                    <th scope="col">{{#str}}col:due, local_hrdashboard{{/str}}</th>
                    <th scope="col">{{#str}}col:completion, local_hrdashboard{{/str}}</th>
                    <th scope="col">{{#str}}col:completedon, local_hrdashboard{{/str}}</th>
                    <th scope="col" class="num">{{#str}}col:grade, local_hrdashboard{{/str}}</th>
                </tr></thead>
                <tbody>
                {{#activities}}
                <tr>
                    <td><img class="icon" src="{{{icon}}}" alt="">{{#url}}<a class="name" href="{{{url}}}">{{name}}</a>{{/url}}{{^url}}<span class="name">{{name}}</span>{{/url}}<span class="sub">{{modnamestr}}</span></td>
                    <td class="hrd-muted">{{section}}</td>
                    <td>{{#overdue}}<span class="hrd-badge hrd-badge--overdue">{{due}}</span>{{/overdue}}{{^overdue}}<span class="{{^hasdue}}hrd-muted{{/hasdue}}">{{due}}</span>{{/overdue}}</td>
                    <td>{{#status}}{{> local_hrdashboard/status }}{{/status}}</td>
                    <td class="{{^timecompletedset}}hrd-muted{{/timecompletedset}}">{{timecompleted}}</td>
                    <td class="num">{{grade}}</td>
                </tr>
                {{/activities}}
                </tbody>
            </table>
            </div>
            {{/hasactivities}}
            {{^hasactivities}}
            <div class="hrd-empty">
                <p class="hrd-empty__title">{{#str}}empty:noactivitiestitle, local_hrdashboard{{/str}}</p>
                <p class="hrd-empty__text">{{#str}}empty:noactivitiestext, local_hrdashboard{{/str}}</p>
            </div>
            {{/hasactivities}}
            {{/enabled}}
        </div>
    </section>
    {{/selected}}
</div>
