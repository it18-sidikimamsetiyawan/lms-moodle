{{!
    @template local_hrdashboard/course_detail

    HR drill-down: one course, its activities and its learners by status.

    Context variables required for this template:
    * course - {shortname, categoryname, viewurl, enddate}
    * backurl, generated, canexport, exports
    * kpis - {kpis: [...]}
    * activities - [{name, modnamestr, icon, due, completed, enrolled, completionrate}]; hasactivities
    * tabs - [{label, url, count, active}]
    * employees - rows; hasemployees; employeecount

    Example context (json):
    {
        "course": {"shortname": "SAFE", "categoryname": "Compliance", "viewurl": "#", "enddate": ""},
        "backurl": "#", "generated": "", "canexport": false, "exports": [], "kpis": {"kpis": []},
        "activities": [], "hasactivities": false, "tabs": [], "employees": [], "hasemployees": false, "employeecount": 0
    }
}}
<div class="hrd">
    <div class="hrd-pagehead">
        <div>
            <a class="hrd-back" href="{{{backurl}}}">&larr; {{#str}}backtodashboard, local_hrdashboard{{/str}}</a>
            <p class="hrd-pagehead__sub"><strong>{{course.shortname}}</strong> · {{course.categoryname}}{{#course.enddate}} · {{#str}}enddate{{/str}}: {{course.enddate}}{{/course.enddate}} <span class="hrd-muted">· {{#str}}generatedat, local_hrdashboard, {{generated}}{{/str}}</span></p>
        </div>
        <div class="hrd-pagehead__actions">
            <a class="btn btn-outline-secondary btn-sm" href="{{{course.viewurl}}}">{{#str}}viewcourse, local_hrdashboard{{/str}}</a>
            {{#canexport}}
            <div class="dropdown">
                <button class="btn btn-primary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" data-toggle="dropdown" aria-expanded="false">{{#str}}export, local_hrdashboard{{/str}}</button>
                <div class="dropdown-menu dropdown-menu-end dropdown-menu-right">
                    {{#exports}}<a class="dropdown-item" href="{{{url}}}">{{label}}</a>{{/exports}}
                </div>
            </div>
            {{/canexport}}
        </div>
    </div>

    {{#kpis}}{{> local_hrdashboard/kpis }}{{/kpis}}

    <section class="hrd-surface" aria-labelledby="hrd-emp-title">
        <div class="hrd-surface__head hrd-surface__head--divided">
            <div>
                <h3 class="hrd-surface__title" id="hrd-emp-title">{{#str}}section:employees, local_hrdashboard{{/str}}</h3>
                <p class="hrd-surface__desc">{{#str}}employeecount, local_hrdashboard, {{employeecount}}{{/str}}</p>
            </div>
            <nav class="hrd-tabs" aria-label="{{#str}}filter:status, local_hrdashboard{{/str}}">
                {{#tabs}}<a class="hrd-tab{{#active}} is-active{{/active}}" href="{{{url}}}"{{#active}} aria-current="page"{{/active}}>{{label}} <span class="hrd-tab__count">{{count}}</span></a>{{/tabs}}
            </nav>
        </div>
        <div class="hrd-surface__body hrd-surface__body--flush">
            {{#hasemployees}}
            <div class="hrd-table-wrap">
            <table class="hrd-table" data-hrd-sortable>
                <thead><tr>
                    <th scope="col" class="cell-title"><button type="button" class="hrd-sort">{{#str}}col:employee, local_hrdashboard{{/str}}</button></th>
                    <th scope="col" style="min-width:160px"><button type="button" class="hrd-sort">{{#str}}col:progress, local_hrdashboard{{/str}}</button></th>
                    <th scope="col" class="num"><button type="button" class="hrd-sort">{{#str}}col:pending, local_hrdashboard{{/str}}</button></th>
                    <th scope="col" class="num"><button type="button" class="hrd-sort">{{#str}}col:score, local_hrdashboard{{/str}}</button></th>
                    <th scope="col"><button type="button" class="hrd-sort">{{#str}}col:lastactivity, local_hrdashboard{{/str}}</button></th>
                    <th scope="col">{{#str}}col:status, local_hrdashboard{{/str}}</th>
                    <th scope="col"></th>
                </tr></thead>
                <tbody>
                {{#employees}}
                <tr>
                    <td data-sort="{{fullname}}">
                        <div class="hrd-person">
                            <span class="hrd-avatar" aria-hidden="true">{{initials}}</span>
                            <span><a class="hrd-person__name" href="{{{url}}}">{{fullname}}</a>{{#attrs}}<span class="hrd-person__sub">{{attrs}}</span>{{/attrs}}</span>
                        </div>
                    </td>
                    <td data-sort="{{progresspct}}">{{#progress}}{{> local_hrdashboard/progress }}{{/progress}}</td>
                    <td class="num" data-sort="{{pending}}">{{pending}}</td>
                    <td class="num" data-sort="{{scoresort}}">{{score}}</td>
                    <td data-sort="{{lastsort}}">{{lastactivity}}</td>
                    <td>{{#status}}{{> local_hrdashboard/status }}{{/status}}{{#hasreasons}}<ul class="hrd-reasons mt-1">{{#reasons}}<li>{{.}}</li>{{/reasons}}</ul>{{/hasreasons}}</td>
                    <td class="num cell-min"><a class="btn btn-sm btn-outline-secondary" href="{{{url}}}">{{#str}}viewprogress, local_hrdashboard{{/str}}</a></td>
                </tr>
                {{/employees}}
                </tbody>
            </table>
            </div>
            {{/hasemployees}}
            {{^hasemployees}}
            <div class="hrd-empty">
                <p class="hrd-empty__title">{{#str}}empty:noemployeestitle, local_hrdashboard{{/str}}</p>
                <p class="hrd-empty__text">{{#str}}empty:noemployeestext, local_hrdashboard{{/str}}</p>
            </div>
            {{/hasemployees}}
        </div>
    </section>

    <section class="hrd-surface" aria-labelledby="hrd-acts-title">
        <div class="hrd-surface__head hrd-surface__head--divided">
            <div>
                <h3 class="hrd-surface__title" id="hrd-acts-title">{{#str}}section:activities, local_hrdashboard{{/str}}</h3>
                <p class="hrd-surface__desc">{{#str}}section:activitiesdesc, local_hrdashboard{{/str}}</p>
            </div>
        </div>
        <div class="hrd-surface__body hrd-surface__body--flush">
            {{#hasactivities}}
            <div class="hrd-table-wrap">
            <table class="hrd-table" data-hrd-sortable>
                <thead><tr>
                    <th scope="col">{{#str}}col:activity, local_hrdashboard{{/str}}</th>
                    <th scope="col">{{#str}}col:due, local_hrdashboard{{/str}}</th>
                    <th scope="col" class="num"><button type="button" class="hrd-sort">{{#str}}col:completed, local_hrdashboard{{/str}}</button></th>
                    <th scope="col" style="min-width:160px"><button type="button" class="hrd-sort">{{#str}}col:completionrate, local_hrdashboard{{/str}}</button></th>
                </tr></thead>
                <tbody>
                {{#activities}}
                <tr>
                    <td><span class="name"><img class="icon" src="{{{icon}}}" alt="">{{name}}</span><span class="sub">{{modnamestr}}</span></td>
                    <td>{{due}}</td>
                    <td class="num" data-sort="{{completed}}">{{completed}} <span class="hrd-muted">/ {{enrolled}}</span></td>
                    <td data-sort="{{completionpct}}">{{#completionrate}}{{> local_hrdashboard/progress }}{{/completionrate}}</td>
                </tr>
                {{/activities}}
                </tbody>
            </table>
            </div>
            {{/hasactivities}}
            {{^hasactivities}}
            <div class="hrd-empty">
                <p class="hrd-empty__title">{{#str}}empty:noactivitiestitle, local_hrdashboard{{/str}}</p>
                <p class="hrd-empty__text">{{#str}}empty:noactivitiestext, local_hrdashboard{{/str}}</p>
            </div>
            {{/hasactivities}}
        </div>
    </section>
</div>
