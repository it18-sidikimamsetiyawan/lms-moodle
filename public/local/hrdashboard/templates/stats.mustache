{{!
    @template local_hrdashboard/stats

    Secondary metrics as one strip with dividers (not six cards).

    Context variables required for this template:
    * stats - Array of {label, value, tone, sub, hassub, url, hasurl}.

    Example context (json):
    {
        "stats": [
            {"label": "Average progress", "value": "39%", "tone": "default", "hassub": false, "hasurl": false}
        ]
    }
}}
<div class="hrd-stats" role="list">
    {{#stats}}
        {{#hasurl}}<a class="hrd-stat hrd-stat--{{tone}}" role="listitem" href="{{{url}}}">{{/hasurl}}
        {{^hasurl}}<div class="hrd-stat hrd-stat--{{tone}}" role="listitem">{{/hasurl}}
            <span class="hrd-stat__label">{{label}}</span>
            <span class="hrd-stat__value">{{value}}</span>
            {{#hassub}}<span class="hrd-stat__sub">{{sub}}</span>{{/hassub}}
        {{#hasurl}}</a>{{/hasurl}}
        {{^hasurl}}</div>{{/hasurl}}
    {{/stats}}
</div>
