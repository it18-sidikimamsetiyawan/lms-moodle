{{!
    @template local_hrdashboard/empty

    Meaningful empty state: short title and a one-line hint.

    Context variables required for this template:
    * title - string
    * text - string (optional)
    * icon - pix icon html (optional)

    Example context (json):
    { "title": "No employees at risk", "text": "All employees are currently on track.", "icon": "" }
}}
<div class="hrd-empty">
    {{#icon}}<span class="hrd-empty__icon" aria-hidden="true">{{{icon}}}</span>{{/icon}}
    <p class="hrd-empty__title">{{title}}</p>
    {{#text}}<p class="hrd-empty__text">{{text}}</p>{{/text}}
</div>
