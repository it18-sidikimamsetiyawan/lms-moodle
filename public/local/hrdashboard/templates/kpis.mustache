{{!
    @template local_hrdashboard/kpis

    Primary KPI tiles (four across): label, strong number, short description.

    Context variables required for this template:
    * kpis - Array of {label, value, tone, icon, sub, hassub, url, hasurl}.

    Example context (json):
    {
        "kpis": [
            {"label": "Total employees", "value": "120", "tone": "default", "icon": "", "hassub": true, "sub": "All confirmed users", "hasurl": false}
        ]
    }
}}
<div class="hrd-kpis">
    {{#kpis}}
        {{#hasurl}}<a class="hrd-kpi hrd-kpi--{{tone}}" href="{{{url}}}">{{/hasurl}}
        {{^hasurl}}<div class="hrd-kpi hrd-kpi--{{tone}}">{{/hasurl}}
            <span class="hrd-kpi__head">
                <span class="hrd-kpi__label">{{label}}</span>
                <span class="hrd-kpi__ico" aria-hidden="true">{{{icon}}}</span>
            </span>
            <span class="hrd-kpi__value">{{value}}</span>
            {{#hassub}}<span class="hrd-kpi__sub">{{sub}}</span>{{/hassub}}
        {{#hasurl}}</a>{{/hasurl}}
        {{^hasurl}}</div>{{/hasurl}}
    {{/kpis}}
</div>
